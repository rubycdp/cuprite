module Ferrum
  class Error < StandardError
  end

  class StatusError < Error
  end

  class TimeoutError < Error
  end

  class NavigationTimeoutError < TimeoutError
    def url: () -> String

    def pendings: () -> Array[String]
  end

  class NoSuchTargetError < Error
  end

  class NoSuchPageError < NoSuchTargetError
  end

  class DeadBrowserError < Error
  end

  class CoordinatesNotFoundError < Error
  end

  class BrowserError < Error
    def response: () -> untyped
  end

  class NodeNotFoundError < BrowserError
  end

  class NoExecutionContextError < BrowserError
  end

  class JavaScriptError < BrowserError
    def class_name: () -> String?
  end

  class Browser
    class Options
      def window_size: () -> [Integer, Integer]?
    end

    def options: () -> Options

    def initialize: (?Hash[Symbol, untyped]? options) -> void
  end

  class Page
    NAVIGATION_WAIT: Float

    def frame_by: (?id: String?, ?name: String?, ?execution_id: Integer?) -> Frame?

    def main_frame: () -> Frame

    def target_id: () -> String

    def timeout: () -> Numeric
  end

  class Client
  end

  class SessionClient
  end

  class Deadline
  end

  class CyclicObject
  end

  class Frame
  end

  class Node
  end

  class Target
  end

  class Dialog
  end
end
