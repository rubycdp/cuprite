module Ferrum
  class Browser
    class Options
      attr_writer window_size: [Integer, Integer]?
      attr_accessor url_blacklist: Array[Regexp]
      attr_accessor url_whitelist: Array[Regexp]
      attr_accessor raise_on_unhandled_modal: bool?
      attr_accessor raise_on_js_errors: bool?
      attr_accessor raise_on_pending_connections: bool

      def mobile: () -> bool?

      def scale_factor: () -> Numeric

      def device_user_agent: () -> String?

      def default_user_agent: () -> String?

      def reset_window_size: () -> [Integer, Integer]?
    end
  end
end
