module Capybara
  module Cuprite
    class Browser < Ferrum::Browser
      module Extensions : Ferrum::Browser
        def raise_on_unhandled_modal: () -> bool?

        def raise_on_unhandled_modal=: (bool? value) -> bool?

        def url_whitelist: () -> Array[Regexp]

        alias url_allowlist url_whitelist

        def url_whitelist=: (Regexp | Array[Regexp] | nil patterns) -> void

        alias url_allowlist= url_whitelist=

        def url_blacklist: () -> Array[Regexp]

        alias url_blocklist url_blacklist

        def url_blacklist=: (Regexp | Array[Regexp] | nil patterns) -> void

        alias url_blocklist= url_blacklist=
      end
    end
  end
end
