module Capybara
  module Cuprite
    class Node < Capybara::Driver::Node
      include Extensions
      include Typing

      type key = String | Symbol | Array[String | Symbol] | nil

      type drop_item = String | Hash[String | Symbol, String]

      type offset = { x: Numeric, y: Numeric, position: Symbol }

      DRAG_MODIFIER_ALIASES: Hash[Symbol, Symbol]
      DRAG_HTML5_JS: String
      TRIGGER_CLICK_WAIT: Float

      attr_reader node: Ferrum::Node

      @tag_name: String?

      def initialize: (Driver driver, Ferrum::Node node, ?Finder::Hints::cache initial_cache) -> void

      def find_xpath: (String selector, **Finder::Hints::hint hints) -> Array[Node]

      def find_css: (String selector, **Finder::Hints::hint hints) -> Array[Node]

      def all_text: () -> String

      def visible_text: () -> String

      def []: (String | Symbol name) -> (String | Numeric | bool)?

      def value: () -> (String | Array[String])?

      def style: (Array[String] styles) -> Hash[String, String]

      def set: (untyped value, ?Hash[Symbol, untyped] options) -> void

      def select_option: () -> bool

      def unselect_option: () -> true

      def tag_name: () -> String

      def visible?: () -> bool

      def checked?: () -> bool

      def selected?: () -> bool

      def disabled?: () -> bool

      def click: (?Array[Symbol] keys, ?x: Numeric?, ?y: Numeric?, ?offset: (:center | :top)?, ?delay: Numeric?) -> Ferrum::Node

      def right_click: (?Array[Symbol] keys, ?x: Numeric?, ?y: Numeric?, ?offset: (:center | :top)?, ?delay: Numeric?) -> Ferrum::Node

      def double_click: (?Array[Symbol] keys, ?x: Numeric?, ?y: Numeric?, ?offset: (:center | :top)?, ?delay: Numeric?) -> Ferrum::Node

      def hover: () -> void

      def drag_to: (Node other, ?x: Numeric?, ?y: Numeric?, ?offset: (:center | :top)?, ?steps: Integer, ?scroll: bool, ?delay: Numeric?, ?html5: bool?, ?drop_modifiers: Symbol | Array[Symbol]) -> void

      def drop: (*drop_item args) -> void

      def trigger: (String | Symbol event) -> void

      def scroll_to: (Node? element, Symbol? location, ?[Numeric, Numeric]? position) -> self

      def scroll_by: (Numeric x, Numeric y) -> void

      def ==: (untyped other) -> bool

      def send_keys: (*key keys) -> void

      def path: () -> String

      def obscured?: () -> bool

      def shadow_root: () -> Node?

      def rect: () -> Hash[String, Numeric]

      def inspect: () -> String

      private

      def find: (:css | :xpath method, String selector, **Finder::Hints::hint hints) -> Array[Node]

      def command: [T] () { () -> T } -> T
                 | (Symbol function, *Driver::script_value args) -> Driver::script_value

      def prepare_and_click: (Symbol name, Array[Symbol] keys, Hash[Symbol, untyped] options, ?button: :left | :right, ?count: Integer) -> Ferrum::Node

      def js: (Symbol function, *Driver::script_value args) -> Driver::script_value

      def before_click: (Symbol | String name, ?(offset | Hash[untyped, untyped]) offset) -> void

      def pinpoint: (?x: Numeric, ?y: Numeric, ?position: :center | :top) -> [Float, Float]

      def drag: (Ferrum::Node other, Array[Symbol] modifiers, Hash[Symbol, untyped] options) -> void

      def drop_offset: (Numeric? x, Numeric? y, (String | Symbol)? position) -> offset?

      def filter_text: (String text) -> String

      def scroll_element_to_location: (Node element, :top | :bottom | :center location) -> void

      def scroll_to_location: (:top | :bottom | :center location) -> void

      def scroll_to_coords: (Numeric x, Numeric y) -> void
    end
  end
end
