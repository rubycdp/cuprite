module Capybara
  module Cuprite
    class Browser < Ferrum::Browser
      include Extensions

      EXTENSION_JS: String

      @settings: Settings
      @page: Ferrum::Page?
      @page_closed: bool
      @page_states: Hash[String, PageState]

      def initialize: (?Hash[Symbol, untyped]? options) -> void

      def command: (String method, ?timeout: (Numeric | Ferrum::Deadline)?, **untyped params) -> Hash[String, untyped]

      def page: () -> Ferrum::Page

      def page_state: (?Ferrum::Page page) -> PageState

      def go_to: (?String? url, ?timeout: (Numeric | Ferrum::Deadline)?, ?referrer: String?) -> String?

      def set_viewport: (?width: Integer, ?height: Integer, ?scale_factor: Numeric, ?mobile: bool?) -> nil

      def at_css: (String selector, ?within: Ferrum::Node?) -> Ferrum::Node?

      def at_xpath: (String selector, ?within: Ferrum::Node?) -> Ferrum::Node?

      def css: (String selector, ?within: Ferrum::Node?) -> Array[Ferrum::Node]

      def xpath: (String selector, ?within: Ferrum::Node?) -> Array[Ferrum::Node]

      def html: () -> String

      def evaluate: (String expression, *untyped positional, **untyped keywords) -> untyped

      def execute: (String expression, *untyped positional, **untyped keywords) -> nil

      def reset: () -> void

      def quit: () -> void

      def resize: (?width: Integer?, ?height: Integer?, ?fullscreen: bool) -> nil

      def current_window_handle: () -> String

      def window_handles: () -> Array[String]

      def open_new_window: (?(:tab | :window) kind) -> Ferrum::Page

      def switch_to_window: (String target_id) -> nil

      def close_window: (String target_id) -> Ferrum::Target?

      private

      def forget_page: () -> void

      def window_target: (String target_id) -> Ferrum::Target

      def prepare_page: (Ferrum::Page page) -> void

      def subscribe_to_js_errors: (Ferrum::Page page) -> void

      def emulate_device_user_agent: (Ferrum::Page page) -> void

      def active_frame: () -> Ferrum::Frame
    end
  end
end
