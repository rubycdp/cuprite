module Capybara
  module Cuprite
    class Browser < Ferrum::Browser
      include Extensions

      @page: Page?
      @page_closed: bool

      def initialize: (?Hash[Symbol, untyped]? options) -> void

      def command: (*untyped, **untyped) -> Hash[String, untyped]

      def page: () -> Page

      def reset: () -> void

      def quit: () -> void

      def resize: (**untyped options) -> untyped

      def current_window_handle: () -> String

      def window_handles: () -> Array[String]

      def open_new_window: () -> Page

      def switch_to_window: (String target_id) -> untyped

      def close_window: (String target_id) -> untyped

      private

      def forget_page: () -> void

      def window_target: (String target_id) -> Ferrum::Target

      def attach_page: (?String? target_id) -> Page
    end
  end
end
