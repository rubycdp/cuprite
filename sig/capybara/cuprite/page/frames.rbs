module Capybara
  module Cuprite
    class Page < Ferrum::Page
      module Frames : Ferrum::Page
        extend Forwardable

        @frame_stack: Array[String]

        def initialize: (Ferrum::Client | Ferrum::SessionClient client, context_id: String?, target_id: String, ?proxy: Hash[Symbol, String | Integer]?) -> void

        def at_css: (String selector, ?within: Ferrum::Node?) -> Ferrum::Node?

        def at_xpath: (String selector, ?within: Ferrum::Node?) -> Ferrum::Node?

        def css: (String selector, ?within: Ferrum::Node?) -> Array[Ferrum::Node]

        def xpath: (String selector, ?within: Ferrum::Node?) -> Array[Ferrum::Node]

        def html: () -> String

        def execution_id: () -> Integer?

        def execution_id!: (?Numeric? timeout) -> Integer

        def evaluate: (String expression, *untyped positional, **untyped keywords) -> untyped

        def execute: (String expression, *untyped positional, **untyped keywords) -> nil

        def switch_to_frame: (String | :parent | :top handle) -> void

        private

        def active_frame: () -> Ferrum::Frame
      end
    end
  end
end
