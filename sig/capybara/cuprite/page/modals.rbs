module Capybara
  module Cuprite
    class Page < Ferrum::Page
      module Modals : Ferrum::Page
        MODAL_WAIT: Float

        @accept_modal: Array[bool]
        @modal_messages: Array[String?]
        @modal_response: String?
        @unhandled_modal_error: UnhandledModalError?
        @settings: Browser::Settings

        def initialize: (Ferrum::Client | Ferrum::SessionClient client, settings: Browser::Settings, context_id: String?, target_id: String, ?proxy: Hash[Symbol, String | Integer]?) -> void

        def command: (String method, ?timeout: (Numeric | Ferrum::Deadline)?, **untyped params) -> Hash[String, untyped]

        def accept_confirm: () -> Array[bool]

        def dismiss_confirm: () -> Array[bool]

        def accept_prompt: (String? modal_response) -> String?

        def dismiss_prompt: () -> Array[bool]

        def find_modal: (Driver::modal_options options) -> String

        private

        def raise_pending_unhandled_modal_error!: [T] () { () -> T } -> T

        def prepare_page: () -> void

        def handle_dialog: (Ferrum::Dialog dialog) -> nil

        def answer_dialog: (Ferrum::Dialog dialog, bool accept, String? response) -> nil
      end
    end
  end
end
