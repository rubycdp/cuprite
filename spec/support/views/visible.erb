<!DOCTYPE html>
<html>
  <head>
    <title>Test</title>
  </head>

  <body>
    <ul>
      <li>Visible</li>
      <li style="display: none">Display None</li>
      <li style="visibility: hidden">Hidden</li>
      <li style="opacity: 0.0">Transparent</li>
    </ul>
    <div>
      <span style="display: none">Display None</span>
      <span style="visibility: hidden">Hidden</span>
    </div>
    <section style="opacity: 0.0">
      <div popover id="popover_in_transparent">Popover In Transparent</div>
      <dialog id="dialog_in_transparent">Dialog In Transparent</dialog>
    </section>
    <section style="display: none">
      <div popover id="popover_in_display_none">Popover In Display None</div>
    </section>
  </body>
</html>
